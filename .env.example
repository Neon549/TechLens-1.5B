# Paths on the GPU inference host. Do not commit real model paths or secrets.
TECHLENS_BASE_MODEL_PATH=/opt/models/Qwen3-1.7B
TECHLENS_SFT_ADAPTER_PATH=/opt/techlens/models/adapters/techlens-1.7b-sft
TECHLENS_DPO_ADAPTER_PATH=/opt/techlens/models/adapters/techlens-1.7b-dpo
TECHLENS_DEVICE=cuda

# Use localhost when the backend and model service share a GPU host.
TECHLENS_HOST=127.0.0.1
TECHLENS_PORT=8088
